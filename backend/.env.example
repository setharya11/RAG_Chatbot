# Copy to .env and fill in secrets.
# PostgreSQL (same layout as Plutus)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=rag_chatbot

# API security
SECRET_KEY=change-to-long-random-string
X_API_KEY=your-mobile-or-frontend-api-key

# JWT
JWT_ALGORITHM=HS256
TOKEN_EXPIRY_HOURS=24

# Public URLs
BASE_URL=http://127.0.0.1:8000
APP_NAME=RAG Chatbot
MEDIA_PATH=media
