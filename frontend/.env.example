# Copy to .env.local — Next only reads env at startup (restart npm run dev after edits).

# Public API base (usually empty in dev — Next proxies /users, /health, /media → backend)
NEXT_PUBLIC_API_URL=

# REQUIRED: must equal backend X_API_KEY in rag_chatbot/backend/.env (same string, no quotes).
NEXT_PUBLIC_X_API_KEY=your-mobile-or-frontend-api-key

# Optional: where next.config rewrites proxy to (default http://127.0.0.1:8000)
# BACKEND_URL=http://127.0.0.1:8000
